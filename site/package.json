{
  "name": "cache-vent-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "downloads": "node scripts/build-downloads.mjs",
    "build": "npm run downloads && next build",
    "build:site": "next build",
    "lint": "eslint",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply cache-vent --remote && wrangler deploy",
    "stats": "node scripts/stats.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.155.0"
  }
}
